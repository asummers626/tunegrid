<Page
    x:Class="TuneGrid.App.Views.GuidePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:TuneGrid.App.ViewModels">

    <Grid Padding="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Guide" Style="{StaticResource TitleTextBlockStyle}" Margin="0,0,0,12" />

        <ListView Grid.Row="1" x:Name="ChannelList" ItemDoubleTapped="ChannelList_ItemDoubleTapped">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="vm:GuideRow">
                    <StackPanel Orientation="Horizontal" Spacing="16" Padding="4">
                        <TextBlock Text="{x:Bind Channel.Name}" FontWeight="SemiBold" Width="220" />
                        <TextBlock Text="{x:Bind Channel.Group}" Opacity="0.7" Width="140" />
                    </StackPanel>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
